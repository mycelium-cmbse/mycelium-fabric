{
    "realm":  "mycelium",
    "displayName":  "Mycelium",
    "enabled":  true,
    "sslRequired":  "none",
    "loginTheme":  "mycelium",
    "emailTheme":  "mycelium",
    "registrationAllowed":  true,
    "resetPasswordAllowed":  true,
    "rememberMe":  true,
    "ssoSessionIdleTimeout":  1800,
    "loginWithEmailAllowed":  true,
    "duplicateEmailsAllowed":  false,
    "smtpServer":  {
                       "host":  "mailpit",
                       "port":  "1025",
                       "from":  "no-reply@mycelium.example",
                       "fromDisplayName":  "Mycelium"
                   },
    "clients":  [
                    {
                        "clientId":  "bloom-web",
                        "name":  "Mycelium Bloom",
                        "enabled":  true,
                        "publicClient":  true,
                        "protocol":  "openid-connect",
                        "standardFlowEnabled":  true,
                        "directAccessGrantsEnabled":  false,
                        "baseUrl":  "http://localhost:5209/",
                        "redirectUris":  [
                                             "http://localhost:5209/*"
                                         ],
                        "webOrigins":  [
                                           "http://localhost:5209"
                                       ],
                        "attributes":  {
                                           "pkce.code.challenge.method":  "S256",
                                           "post.logout.redirect.uris":  "http://localhost:5209/*"
                                       }
                    }
                ],
    "users":  [
                  {
                      "username":  "demo",
                      "email":  "demo@example.org",
                      "firstName":  "Demo",
                      "lastName":  "User",
                      "enabled":  true,
                      "emailVerified":  true,
                      "credentials":  [
                                          {
                                              "type":  "password",
                                              "value":  "mycelium",
                                              "temporary":  false
                                          }
                                      ]
                  }
              ],
    "identityProviders":  [
                              {
                                  "alias":  "corporate-sso",
                                  "displayName":  "Corporate SSO",
                                  "providerId":  "saml",
                                  "enabled":  true,
                                  "config":  {
                                                 "guiOrder":  "1",
                                                 "entityId":  "http://localhost:8081/realms/mycelium",
                                                 "singleSignOnServiceUrl":  "https://sso.example.org/saml/sso",
                                                 "nameIDPolicyFormat":  "urn:oasis:names:tc:SAML:2.0:nameid-format:persistent",
                                                 "principalType":  "SUBJECT",
                                                 "postBindingAuthnRequest":  "true",
                                                 "postBindingResponse":  "true",
                                                 "validateSignature":  "true",
                                                 "wantAssertionsSigned":  "true"
                                             }
                              },
                              {
                                  "alias":  "partner-oidc",
                                  "displayName":  "Partner Identity Federation",
                                  "providerId":  "oidc",
                                  "enabled":  true,
                                  "config":  {
                                                 "guiOrder":  "2",
                                                 "authorizationUrl":  "https://login.partner.example.org/oauth2/authorize",
                                                 "tokenUrl":  "https://login.partner.example.org/oauth2/token",
                                                 "clientId":  "mycelium-dev",
                                                 "clientSecret":  "not-a-secret",
                                                 "clientAuthMethod":  "client_secret_post",
                                                 "defaultScope":  "openid profile email",
                                                 "syncMode":  "IMPORT"
                                             }
                              },
                              {
                                  "alias":  "microsoft",
                                  "displayName":  "Microsoft Entra ID",
                                  "providerId":  "microsoft",
                                  "enabled":  true,
                                  "config":  {
                                                 "guiOrder":  "3",
                                                 "clientId":  "mycelium-dev",
                                                 "clientSecret":  "not-a-secret",
                                                 "syncMode":  "IMPORT"
                                             }
                              },
                              {
                                  "alias":  "github",
                                  "displayName":  "GitHub",
                                  "providerId":  "github",
                                  "enabled":  true,
                                  "config":  {
                                                 "guiOrder":  "4",
                                                 "clientId":  "mycelium-dev",
                                                 "clientSecret":  "not-a-secret",
                                                 "syncMode":  "IMPORT"
                                             }
                              }
                          ]
}
