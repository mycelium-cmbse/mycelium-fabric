<?xml version="1.0" encoding="utf-8"?>

<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <!-- No deliberately floored packages. -->
    <ItemGroup>
        <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.4" />
        <PackageVersion Include="Carter" Version="10.0.0" />
        <PackageVersion Include="CsvHelper" Version="33.1.0" />
        <PackageVersion Include="ErrorOr" Version="2.1.1" />
        <PackageVersion Include="Google.OrTools" Version="9.15.6755" />
        <PackageVersion Include="MessagePack" Version="3.1.12" />
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
        <PackageVersion Include="ModelContextProtocol" Version="2.3.0" />
        <PackageVersion Include="SysML2.NET.Dal" Version="0.25.0" />
        <PackageVersion Include="SysML2.NET.Serializer.Json" Version="0.25.0" />
        <PackageVersion Include="SysML2.NET.Serializer.MessagePack" Version="0.25.0" />

        <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageVersion Include="Moq" Version="4.21.0" />
        <PackageVersion Include="NUnit" Version="5.0.0" />
        <PackageVersion Include="NUnit.Console" Version="3.22.0" />
        <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
        <PackageVersion Include="coverlet.collector" Version="10.1.0" />
        <PackageVersion Include="coverlet.msbuild" Version="10.1.0" />
    </ItemGroup>

</Project>
