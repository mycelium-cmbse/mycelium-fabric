<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14.0</LangVersion>
        <Version>0.0.1</Version>
        <Description>The Mycelium Fabric MCP project, exposing SysML v2 models to AI assistants.</Description>
        <Company>Starion Group S.A.</Company>
        <Copyright>Copyright © Starion Group S.A.</Copyright>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/mycelium-cmbse/mycelium-fabric.git</RepositoryUrl>
        <RepositoryType>Git</RepositoryType>
        <Authors>Sam Gerene, Antoine Théate, Régis André, Tanase-Marius Manafu, Omrane Haj Mohamed</Authors>
        <ImplicitUsings>false</ImplicitUsings>
        <Nullable>disable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- The MCP Apps of the C# SDK are experimental (MCPEXP003): the review of a batch by the user relies on them. -->
        <NoWarn>$(NoWarn);MCPEXP003</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="CsvHelper" />
      <PackageReference Include="ErrorOr" />
      <PackageReference Include="Google.OrTools" />
      <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
      <PackageReference Include="ModelContextProtocol" />
      <PackageReference Include="ModelContextProtocol.Extensions.Apps" />
      <PackageReference Include="SysML2.NET.Dal" />
      <PackageReference Include="SysML2.NET.Serializer.Json" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="McpApp\*.html;McpApp\*.css;McpApp\*.js" LogicalName="Mycelium.Fabric.Mcp.McpApp.%(Filename)%(Extension)" />
    </ItemGroup>

</Project>
